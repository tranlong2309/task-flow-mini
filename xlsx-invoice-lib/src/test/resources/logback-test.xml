<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 
      Set to INFO to prevent intentional exception stack traces (logged at DEBUG) 
      from flooding the console during tests. 
    -->
    <logger name="com.company.invoice.xlsx" level="INFO" />
    
    <root level="WARN">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
